DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-for-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP para envio do e-mail de recuperação de senha ("Esqueci minha senha").
# Sem essas variáveis preenchidas, o link de recuperação apenas é registrado
# no log do servidor (modo desenvolvimento) em vez de ser enviado por e-mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="\"Slotta\" <no-reply@slotta.app>"

# WhatsApp (lembretes automáticos de agendamento). Sem essas variáveis, as
# mensagens apenas são registradas no log do servidor (modo desenvolvimento).
# Ver WHATSAPP_SETUP.md para o passo a passo completo.
WHATSAPP_PROVIDER=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_TEMPLATE_LANG="pt_BR"
WHATSAPP_TEMPLATE_CONFIRMED="appointment_confirmed"
WHATSAPP_TEMPLATE_REMINDER="appointment_reminder"
WHATSAPP_TEMPLATE_CANCELLED="appointment_cancelled"

# Worker de lembretes (roda dentro do próprio processo do servidor).
REMINDER_WORKER_INTERVAL_SECONDS="60"
DISABLE_REMINDER_WORKER="false"
