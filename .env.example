NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMTP para envio do e-mail de recuperação de senha ("Esqueci minha senha").
# Sem essas variáveis preenchidas, o link de recuperação apenas é registrado
# no log do servidor (modo desenvolvimento) em vez de ser enviado por e-mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="\"Slotta\" <no-reply@slotta.app>"
