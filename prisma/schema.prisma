generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String?
  logo        String?
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  services    Service[]
  customers   Customer[]
  appointments Appointment[]
  businessHours BusinessHour[]
  blockedTimes BlockedTime[]
  notifications Notification[]
  reminderSetting ReminderSetting?
  reminders    Reminder[]
  reviewRequests ReviewRequest[]
  waitlistEntries WaitlistEntry[]

  // Assinatura (Stripe). "trial" é nosso estado inicial, antes de qualquer
  // contato com o Stripe; os demais valores são o status bruto que o Stripe
  // devolve (active, past_due, canceled, unpaid, ...).
  subscriptionStatus   String    @default("trial")
  trialEndsAt          DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  // 0 = nenhum aviso de fim de teste enviado; 1 = aviso de 3 dias; 2 = aviso das últimas 24h.
  trialNoticeStage     Int       @default(0)
}

model User {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  email         String   @unique
  passwordHash  String
  role          String   @default("ADMIN")
  notifyEmailFallback Boolean @default(true)
  notifyDailyDigest   Boolean @default(true)
  lastDigestOn        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company      Company @relation(fields: [companyId], references: [id])
  notifications Notification[]
  passwordResetTokens PasswordResetToken[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id])
}

model Service {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  price           Float
  durationMinutes Int
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company @relation(fields: [companyId], references: [id])
  appointments   Appointment[]
  waitlistEntries WaitlistEntry[]
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id               String   @id @default(cuid())
  companyId        String
  serviceId        String
  customerId       String
  date             String
  startTime       String
  endTime         String
  price           Float
  status          String   @default("PENDING")
  notes           String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company @relation(fields: [companyId], references: [id])
  service         Service @relation(fields: [serviceId], references: [id])
  customer        Customer @relation(fields: [customerId], references: [id])
  notifications   Notification[]
  reminders       Reminder[]
  reviewRequest   ReviewRequest?
}

model BusinessHour {
  id          String   @id @default(cuid())
  companyId   String
  dayOfWeek   Int
  openingTime String
  closingTime String
  breakStart  String?
  breakEnd    String?
  active      Boolean  @default(true)

  company     Company @relation(fields: [companyId], references: [id])
}

model BlockedTime {
  id          String   @id @default(cuid())
  companyId   String
  date        String
  startTime   String
  endTime     String
  reason      String?

  company     Company @relation(fields: [companyId], references: [id])
}

model ReminderSetting {
  id        String   @id @default(cuid())
  companyId String   @unique
  enabled   Boolean  @default(false)
  testMode  Boolean  @default(false)
  reviewEnabled      Boolean @default(false)
  reviewUrl          String?
  reviewDelayMinutes Int     @default(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id])
  intervals ReminderInterval[]
}

model ReminderInterval {
  id                String  @id @default(cuid())
  reminderSettingId String
  key               String
  label             String
  minutesBefore     Int
  active            Boolean @default(true)
  testOnly          Boolean @default(false)

  reminderSetting ReminderSetting @relation(fields: [reminderSettingId], references: [id])

  @@unique([reminderSettingId, key])
}

model Reminder {
  id            String    @id @default(cuid())
  companyId     String
  appointmentId String
  type          String
  minutesBefore Int
  scheduledFor  DateTime
  status        String    @default("PENDING")
  sentAt        DateTime?
  error         String?
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company     @relation(fields: [companyId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([appointmentId, type])
  @@index([status, scheduledFor])
}

model Notification {
  id            String   @id @default(cuid())
  companyId     String
  userId        String?
  appointmentId String?
  title         String
  message       String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  company       Company @relation(fields: [companyId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
}

model ReviewRequest {
  id            String    @id @default(cuid())
  companyId     String
  appointmentId String    @unique
  status        String
  channels      String?
  error         String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  company     Company     @relation(fields: [companyId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([companyId, createdAt])
}

model WaitlistEntry {
  id           String    @id @default(cuid())
  companyId    String
  serviceId    String
  customerName String
  phone        String
  phoneDigits  String
  email        String?
  date         String
  status       String    @default("WAITING")
  notifiedAt   DateTime?
  channels     String?
  createdAt    DateTime  @default(now())

  company      Company   @relation(fields: [companyId], references: [id])
  service      Service   @relation(fields: [serviceId], references: [id])

  @@unique([companyId, serviceId, date, phoneDigits])
  @@index([status, date])
  @@index([companyId, date])
}
